# Wearables (Whoop / Oura) — add to .env.local / Vercel
#
# WHOOP: https://developer.whoop.com — create an app, add redirect URI
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Optional override (default: {NEXT_PUBLIC_APP_URL}/api/wearables/whoop/callback)
# WHOOP_REDIRECT_URI=https://your-domain.com/api/wearables/whoop/callback
#
# Oura: https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# OURA_REDIRECT_URI=https://your-domain.com/api/wearables/oura/callback
#
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional extra HMAC secret for OAuth state cookies
# WEARABLE_OAUTH_STATE_SECRET=
